// Cloudflare Workers: the static site, plus a small server for /api (the community).
{
  "name": "fmcheck",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The community: D1 database and the Google sign-in client id
  "d1_databases": [{ "binding": "DB", "database_name": "fmcheck-community", "database_id": "e40ee919-f3e1-4f2b-9d91-d91d85b30c9d" }],
  // Workers Logs: errors and the warnings the server writes about suspicious requests
  "observability": { "enabled": true },
  // Example posts (src/demo.json) show, tagged "Example", until 30 real items are up. "DEMO": "off" hides them.
  // ADMIN_IDS: account ids (shown on admin.html) that can remove items and clear reports. Not secret: a one-way code.
  "vars": { "GOOGLE_CLIENT_ID": "123250047088-qaj5de9sgejg2jqo35l6a9nqt8om0ja1.apps.googleusercontent.com",
    "ADMIN_IDS": "9e6d7711ca989537c1f9f774200f23bd" }
}
