// Cloudflare Workers: the static site, plus a small server for /api (the community).
{
  "name": "fmcheck",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The community: D1 database and the Google sign-in client id
  "d1_databases": [{ "binding": "DB", "database_name": "fmcheck-community", "database_id": "e40ee919-f3e1-4f2b-9d91-d91d85b30c9d" }],
  // DEMO off: example items hidden (their prices weren't realistic). Remove it to show them again.
  "vars": { "GOOGLE_CLIENT_ID": "123250047088-qaj5de9sgejg2jqo35l6a9nqt8om0ja1.apps.googleusercontent.com", "DEMO": "off" }
}
