// Cloudflare Workers: the static site, plus a small server for /api (reported sales).
{
  "name": "fmcheck",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Sale reports are stored in this KV namespace (fmcheck-sales)
  "kv_namespaces": [{ "binding": "SALES", "id": "1ee0771d2f294f979e571a65aa37c295" }]
  // The community needs a D1 database and the Google sign-in client id:
  // ,"d1_databases": [{ "binding": "DB", "database_name": "fmcheck-community", "database_id": "<database id>" }]
  ,"vars": { "GOOGLE_CLIENT_ID": "123250047088-qaj5de9sgejg2jqo35l6a9nqt8om0ja1.apps.googleusercontent.com" }
}
